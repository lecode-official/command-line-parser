<Project Sdk="Microsoft.NET.Sdk">
    <!-- Build Configuration -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CliNetCore</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <!-- Assembly Info -->
    <PropertyGroup>
        <AssemblyTitle>CLI.NET Core</AssemblyTitle>
        <Product>CLI.NET Core</Product>
        <NeutralLanguage>en-US</NeutralLanguage>
    </PropertyGroup>

    <!-- NuGet Package Information -->
    <PropertyGroup>
        <PackageId>CliNetCore</PackageId>
        <Version>0.1.0</Version>
        <title>CLI.NET Core</title>
        <Authors>David Neumann</Authors>
        <Description>A command line application framework in the style of ASP.NET Core.</Description>
        <Copyright>Copyright © 2026 David Neumann</Copyright>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/lecode-official/command-line-parser/blob/master/source/clinet-core</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/lecode-official/command-line-parser</RepositoryUrl>
    </PropertyGroup>

    <!-- Referenced NuGet Packages -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />

        <!--
            Roslyn never expands <inheritdoc/> into real text in the generated XML documentation file, it is left in verbatim, so any tool
            reading that file (xmldoc2md, a consumer's IDE tooltip for the compiled package, ...) sees an empty member; this task rewrites
            <inheritdoc/> into the real, inherited text as a build step, for every non-Debug build (see Documentation Site and Dependency
            Management); "PrivateAssets=all" keeps it a build-time-only dependency of this project, it is never referenced by a consumer of the
            compiled package
        -->
        <PackageReference Include="SauceControl.InheritDoc" Version="2.0.2" PrivateAssets="all" />
    </ItemGroup>

    <!-- Internals Visibility -->
    <ItemGroup>
        <!--
            Grants the unit test project access to internal members, so that internal types (for example CliCommandDispatcherService) can be unit
            tested directly instead of only indirectly through the public surface that wraps them
        -->
        <InternalsVisibleTo Include="CLI.NET Core Unit Tests" />
    </ItemGroup>
</Project>
