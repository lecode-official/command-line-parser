{
    // List of extensions which should be recommended for users of this workspace
    "recommendations": [
        // Language support for .gitignore files
        "codezombiech.gitignore",

        // Perform spell-checking of the documentation, code, and comments with support for warnings/errors in Visual Studio Code
        "streetsidesoftware.code-spell-checker",

        // Integrates MarkdownLint into the editor
        "DavidAnson.vscode-markdownlint",

        // Integrates the dprint code formatter into the editor
        "dprint.dprint",

        // Enables us to have a shared Visual Studio configuration, while allowing each user to locally add or overwrite settings
        "Swellaby.workspace-config-plus",

        // Adds useful features for editing Markdown tables
        "TakumiI.markdowntable",

        // Highlights TODOs, FIXMEs, HACKs, DEBUGs, REVIEWs, and NOTEs inside of code files
        "wayou.vscode-todo-highlight",

        // Integrates many useful features for editing Markdown
        "yzhang.markdown-all-in-one",
    ],
}
